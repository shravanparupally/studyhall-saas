# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Generated code — never committed, per docs/15_Technical_Architecture.md §15.30
**/*.g.dart
**/*.freezed.dart
/lib/l10n/generated/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Per-environment Firebase config, per docs/15_Technical_Architecture.md
# §15.19 — each of dev/staging/prod has its own file, provided locally by
# `flutterfire configure` or by CI's secret store, never committed. Firebase
# CLI/emulator local state is likewise never committed.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Per-environment runtime config consumed via --dart-define-from-file
# (§15.19) — real per-environment values are never checked in.
/config/*.json
!/config/*.example.json
